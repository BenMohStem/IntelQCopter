# Preserve original evidence bytes, including binary PPM captures and raw logs.
artifacts/** -text
*.png binary
*.jpg binary
*.ppm binary
*.mp4 binary
*.pdf binary
*.zip binary
*.sqlite binary
# Keep measured source hashes stable across Windows/Linux checkouts.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.usda text eol=lf
*.sdf text eol=lf
*.md text eol=lf
*.json text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.ini text eol=lf
*.code-workspace text eol=lf
*.cmd text eol=crlf
# Evidence is retained byte-for-byte, including reports and original logs.
artifacts/** -text
# Preserve the archived baseline/reference bytes after moving them on this branch.
archive/** -text

# Keep curated reference snapshots byte-identical to their source manifest.
important_sources/** -text
