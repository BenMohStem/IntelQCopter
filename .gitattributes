# Preserve original evidence bytes, including binary PPM captures and raw logs.
artifacts/** -text
# Keep imported raw sensor captures byte-for-byte, including their original
# Windows line endings; these are bench evidence rather than normalized CSV.
hardware/bench_calibration/esp32s3_qmc5883p_100hz/captures/** -text
# Freeze retired implementations and their original line endings.
archive/** -text
*.png binary
*.jpg binary
*.ppm binary
*.mp4 binary
*.pdf binary
*.zip binary
# Keep measured source hashes stable across Windows/Linux checkouts.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.usda text eol=lf
*.sdf text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
# Evidence is retained byte-for-byte, including reports and original logs.
artifacts/** -text

*.json text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.code-workspace text eol=lf
archive/** -text
artifacts/** -text
