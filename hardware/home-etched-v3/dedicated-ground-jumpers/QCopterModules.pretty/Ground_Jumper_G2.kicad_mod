(footprint "Ground_Jumper_G2" (version 20240108) (generator "pcbnew") (layer "F.Cu") (attr through_hole)
    (descr "Dedicated two-hole insulated GND jumper. Fit wire above component side. 3.2mm round lands, 1.2mm drill.")
    (property "Reference" "REF**" (at -2 4.4 0) (layer "Dwgs.User") (effects (font (size 1 1))))
    (property "Value" "FIT_INSULATED_GND_WIRE" (at 0 6.4 0) (layer "F.Fab") (effects (font (size .8 .8))) hide)
    (fp_line (start 0 0) (end 0 8.8) (stroke (width .3) (type default)) (layer "Dwgs.User"))
    (pad "1" thru_hole circle (at 0 0) (size 3.2 3.2) (drill 1.2) (layers "*.Cu" "*.Mask"))
    (pad "2" thru_hole circle (at 0 8.8) (size 3.2 3.2) (drill 1.2) (layers "*.Cu" "*.Mask"))
    (model "${KIPRJMOD}/models3d/Ground_Jumper_G2.wrl" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0))))
